# Copy to .env.local for local development (`bun run dev`) — .env.local is git-ignored.
# On Vercel, set these under Project → Settings → Environment Variables instead.

# Required for signups: Beehiiv → Settings → Integrations → API. Never commit the real key.
BEEHIIV_API_KEY=

# Optional (defaults shown)
BEEHIIV_PUBLICATION_ID=pub_8115cd79-d2a8-48ff-a97b-2ca6b47b9ac1
SITE_URL=https://supereyesee.com
